# ============================================================================
# XMAS ROLL — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to `.env` and fill in your credentials.
# ============================================================================

# --- 1. FIREBASE CONFIGURATION (Spark Free Plan Compatible) ---
# Uses Firebase Authentication + Cloud Firestore + Firebase Hosting.
# Project: jmall-xmas-roll
VITE_FIREBASE_API_KEY=AIzaSyCE9LcoPzXsZ3Df-R3i3tFmvLuhws0OcJo
VITE_FIREBASE_AUTH_DOMAIN=jmall-xmas-roll.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=jmall-xmas-roll
VITE_FIREBASE_STORAGE_BUCKET=jmall-xmas-roll.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=672029754347
VITE_FIREBASE_APP_ID=1:672029754347:web:d4c3e77c6e32ec32f4cfae
VITE_FIREBASE_MEASUREMENT_ID=G-K5YT9DE21S

# --- 2. DEFAULT EVENT ID ---
VITE_DEFAULT_EVENT_ID=xmas-party-2026

# --- 3. ADMIN AUTHORIZATION ---
# Comma-separated list of authorized admin emails (in addition to Firestore `admins/{uid}` check)
VITE_ADMIN_EMAILS=mazi39662@gmail.com,organizer@xmasroll.local,admin@jmall.com

# --- 4. IMAGE STORAGE PROVIDER ABSTRACTION ---
# Options: 'firestore' | 'cloudinary' | 'imgbb' | 'local'
VITE_STORAGE_PROVIDER=firestore

# Cloudinary Configuration (Required if VITE_STORAGE_PROVIDER=cloudinary)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_FOLDER=xmas-roll-2026

# ImgBB Configuration (Required if VITE_STORAGE_PROVIDER=imgbb)
VITE_IMGBB_API_KEY=

# Whether to also preserve the unprocessed clean original photo locally in IndexedDB
VITE_PRESERVE_ORIGINAL_PHOTO=true
