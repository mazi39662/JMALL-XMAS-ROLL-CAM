# ============================================================================
# XMAS ROLL — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to `.env` and fill in your credentials.
# Never commit real `.env` secrets to version control!
# ============================================================================

# --- 1. FIREBASE CONFIGURATION (Spark Free Plan Compatible) ---
# Uses Firebase Authentication + Cloud Firestore + Firebase Hosting.
# Note: Firebase Storage is NOT used because it requires the paid Blaze plan.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- 2. DEFAULT EVENT ID ---
VITE_DEFAULT_EVENT_ID=xmas-party-2026

# --- 3. ADMIN AUTHORIZATION ---
# Comma-separated list of authorized admin emails (in addition to Firestore `admins/{uid}` check)
VITE_ADMIN_EMAILS=organizer@xmasroll.local,admin@jmall.com

# --- 4. IMAGE STORAGE PROVIDER ABSTRACTION ---
# Options: 'cloudinary' | 'imgbb' | 'local'
# - 'cloudinary': Recommended free tier (25 GB storage / 25 GB monthly bandwidth, unsigned upload preset)
# - 'imgbb': Free image hosting API (up to 32 MB per image, requires free API key from api.imgbb.com)
# - 'local': Local development adapter (IndexedDB + ObjectURLs; strictly for single-browser testing)
VITE_STORAGE_PROVIDER=local

# Cloudinary Configuration (Required if VITE_STORAGE_PROVIDER=cloudinary)
# Create an UNSIGNED upload preset in Cloudinary Settings -> Upload -> Upload presets
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_FOLDER=xmas-roll-2026

# ImgBB Configuration (Required if VITE_STORAGE_PROVIDER=imgbb)
VITE_IMGBB_API_KEY=

# Whether to also upload the unprocessed clean original photo alongside the 35mm processed frame
# Set to 'true' when using Cloudinary with sufficient quota, or 'false' to save 50% bandwidth
VITE_PRESERVE_ORIGINAL_PHOTO=true

